# Backport Checker Environment Configuration
# Copy this file to .env and fill in your values
# WARNING: Never commit .env file to git!

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# GitHub Personal Access Token
# Get from: https://github.com/settings/tokens
# Required scopes: repo
GITHUB_TOKEN=your_github_token_here

# GitHub Repository (format: owner/repo)
GITHUB_REPOSITORY=ansible/aap-docs

# ============================================================================
# OPTIONAL: SLACK NOTIFICATIONS
# ============================================================================

# Slack Incoming Webhook URL
# Get from: https://api.slack.com/apps → Your App → Incoming Webhooks
# Example: https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX
SLACK_WEBHOOK_URL=

# ============================================================================
# OPTIONAL: JIRA NOTIFICATIONS
# ============================================================================

# Jira Instance URL (no trailing slash)
# Example: https://yourcompany.atlassian.net
JIRA_BASE_URL=

# Your Jira Email Address
JIRA_USER_EMAIL=

# Jira API Token
# Get from: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Jira Issue Key to comment on
# Example: TEAM-123
JIRA_ISSUE_KEY=

# ============================================================================
# OPTIONAL: ADVANCED SETTINGS
# ============================================================================

# Override backport branches (comma-separated)
# Default: 2.4,2.3,2.2,2.1,2.0-ea,1.2
# BACKPORT_BRANCHES=2.4,2.3,2.2

# Always post to Jira even when no issues found
# Default: false
# JIRA_ALWAYS_POST=true
